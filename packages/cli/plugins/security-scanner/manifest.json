{
  "id": "com.spikey.security-scanner",
  "name": "Security Scanner",
  "version": "1.0.0",
  "description": "Detects common security vulnerabilities using static analysis",
  "author": "spikey-official",
  "category": ["security", "analysis"],
  "permissions": ["read:files", "write:reports"],
  "hooks": ["on_analysis_complete"],
  "entry": "index.js",
  "models": ["gpt-4o", "claude-3.5-sonnet"],
  "config": {
    "severity_threshold": {
      "type": "enum",
      "default": "warning",
      "options": ["info", "warning", "error"]
    }
  }
}
